# Copy to .env.local only if you need to override the shipped Habits project.
# Both are safe to expose in the browser — this personal build uses one shared
# household database (see supabase/add-household-open.sql), no logins.
# On Vercel these are optional; the app already defaults to the Habits project.
#
# Without any keys the app still runs local-only.
# Habits / Tally project (NOT the Bible app project).
VITE_SUPABASE_URL=https://amrqzdnsbgoqkckcytjq.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Optional. Free key from https://api.data.gov/signup — raises USDA food-search
# rate limits above the shared DEMO_KEY. Also set USDA_FDC_API_KEY on Vercel for
# the /api/food-search proxy. Common foods still work with no key.
# VITE_USDA_API_KEY=
# USDA_FDC_API_KEY=

# Optional override. The app already ships the Tally Google OAuth client id.
# Create a client at https://console.cloud.google.com/apis/credentials
# with authorized JavaScript origins for localhost and your Vercel domain,
# then enable the Google Calendar API and Gmail API.
# VITE_GOOGLE_CLIENT_ID=

# Agent / cloud access only (never put on Vercel frontend):
# Personal Access Token from https://supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN=sbp_...
# SUPABASE_PROJECT_REF=amrqzdnsbgoqkckcytjq
