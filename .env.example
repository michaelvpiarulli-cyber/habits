# Copy to .env.local and fill in. Both are safe to expose in the browser:
# the publishable key is public by design and row-level security protects data.
# On Vercel, add these same two variables in Project Settings → Environment Variables.
#
# Without them the app still runs — it just stays local-only (no login, no sync).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Optional. Free key from https://api.data.gov/signup — raises USDA food-search
# rate limits above the shared DEMO_KEY. Also set USDA_FDC_API_KEY on Vercel for
# the /api/food-search proxy. Common foods still work with no key.
# VITE_USDA_API_KEY=
# USDA_FDC_API_KEY=

# Agent / cloud access (NEVER put in Vercel frontend env — server/agent only):
# Personal Access Token from https://supabase.com/dashboard/account/tokens
# Lets Cursor cloud agents run SQL via Management API / Supabase MCP.
# SUPABASE_ACCESS_TOKEN=sbp_...
# SUPABASE_PROJECT_REF=satiltslftjqiktjwehr
